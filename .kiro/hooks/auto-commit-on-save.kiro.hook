{
  "enabled": true,
  "name": "Auto Commit & Push on Save",
  "description": "Whenever a source/doc file is saved, stage all changes and, if there is anything to commit, create a commit and push it to the dev branch on GitHub. Skips silently when there are no changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "frontend/src/**/*",
      "server/**/*.mjs",
      "server/**/*.js",
      "server/**/*.json",
      "database/**/*.mjs",
      "database/**/*.js",
      "*.md",
      "*.json",
      "*.html",
      "*.css"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && (git diff --cached --quiet && echo \"No changes to commit\" || (git commit -m \"auto: save changes via hook\" && git push origin dev))",
    "timeout": 120
  }
}