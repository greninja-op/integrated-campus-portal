# Copy to server/.env and fill in real values (server/.env is gitignored)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app>
MONGODB_DB=studentportal
JWT_SECRET=change_me_to_a_long_random_string
PORT=8080
# Comma-separated allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
# Set when running behind a reverse proxy (e.g. 1) so rate limiting sees real client IPs
# TRUST_PROXY=1
